# Local: `pnpm db:local` starts an embedded Postgres (PGlite) on this URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# PGlite handles one connection at a time; leave unset in production.
DATABASE_POOL_MAX=1

# Production: Neon pooled connection string, e.g.
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs the demo session cookie. 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
